# ==============================================================================
# 🚀 Saiaê ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env before starting the application:
#   cp .env.example .env
#
# Variables are sorted by importance and dependency impact.
# ==============================================================================

# ==============================================
# 🎯 1. REQUIRED CORE SETTINGS
# ==============================================

# Server Listening Port (e.g. 3000, 3030). Ensure this port is free!
PORT="3000"

# Database Connection URL (Supports PostgreSQL or MySQL)
# Format: postgresql://user:password@host:port/database?schema=public
# Or: mysql://user:password@host:port/database
# Note: Ensure the protocol match your schema.prisma provider setting!
DATABASE_URL="mysql://root:password@localhost:3306/wa_gateway_db"

# NextAuth Encryption Secret (Generate with: openssl rand -base64 32)
# Server will exit immediately if this is not configured in production!
AUTH_SECRET="your-super-secret-key-at-least-32-chars-change-this-in-production"

# Base URL where your application is hosted (e.g. http://localhost:3000 or https://your-domain.com)
BASE_URL="http://localhost:3000"

# Application Environment Mode (development | production | test)
NODE_ENV="development"

# Server Hostname binding
HOSTNAME="localhost"


# ==============================================
# 🔗 2. NEXTAUTH & PROXY INTEGRATION
# ==============================================

# URL for NextAuth redirects (Should match BASE_URL)
NEXTAUTH_URL="${BASE_URL}"

# Trust Proxy Headers (Set to "true" if deployed behind Nginx, Cloudflare, or reverse proxies)
AUTH_TRUST_HOST="true"

# Public facing Next.js URLs (Derived from BASE_URL)
NEXT_PUBLIC_APP_URL="${BASE_URL}"
NEXT_PUBLIC_API_URL="${BASE_URL}/api"


# ==============================================
# 🎨 3. BRANDING & GENERAL SETTINGS
# ==============================================

# Name of the application displayed in headers and sidebar
APP_NAME="Saiaê"

# Custom Logo URL (leave empty to use default asset)
LOGO_URL=""

# Custom Favicon URL (leave empty to use default asset)
FAVICON_URL=""

# Chat list page size pagination limit (default: 50)
NEXT_PUBLIC_CHAT_PAGE_SIZE="50"

# Allow search engines to index public pages like docs/landing (true | false)
NEXT_PUBLIC_ALLOW_INDEXING="false"


# ==============================================
# 📚 4. SWAGGER API DOCUMENTATION (/docs)
# ==============================================

# Enable or disable the Swagger UI documentation route (true | false)
NEXT_PUBLIC_SWAGGER_ENABLED="true"

# Username for accessing Swagger UI basic auth credentials
NEXT_PUBLIC_SWAGGER_USERNAME="admin"

# Password for accessing Swagger UI basic auth credentials (change in production!)
NEXT_PUBLIC_SWAGGER_PASSWORD="admin123"


# ==============================================
# 🔌 5. WHATSAPP CORE (Baileys Engine)
# ==============================================

# Cobranca (planos, cotas, trial, suspensao). PADRAO: desligada.
# BILLING_ENFORCEMENT: "off" (padrao, tambem quando ausente) = todos sem limite de numeros e disparos,
#   trial nao expira, nada e bloqueado por plano. "on" = volta ao comportamento normal de planos.
#   Reversivel: nada de Stripe, planos ou contadores foi removido. Ao ligar de novo, quem se
#   cadastrou durante o periodo "off" pode estar com o trial de 3 dias vencido; ajuste em Usuarios.
# AI_MONTHLY_CAP: teto mensal de textos com IA por usuario com a cobranca desligada (custo do Gemini).
#   Padrao 200 se ausente ou invalido; nunca fica ilimitado. Com BILLING_ENFORCEMENT=on vale o limite do plano.
BILLING_ENFORCEMENT="off"
AI_MONTHLY_CAP="200"

# Eventos Comanda -> CRM (POST /api/integracao/comanda/v1/eventos). Ver docs/INTEGRACAO_COMANDA_EVENTOS.md.
# COMANDA_WEBHOOK_SECRETS: JSON barraca_id -> segredo (>= 16 caracteres), ou lista para rotacao.
#   Ex.: {"<barraca_id>":"<segredo>"}. Ausente ou invalido = a rota responde 503. Definido so no Railway.
COMANDA_WEBHOOK_SECRETS=""
# COMANDA_CODIGO_SECRET: segredo de PLATAFORMA (>= 16 caracteres; lista com virgula para rotacao) da rota
#   POST /api/integracao/comanda/v1/codigo-verificacao (codigo de login do cliente final). Ausente = 503.
COMANDA_CODIGO_SECRET=""
# COMANDA_NOTIFY_TEMPLATES: "on" liga os avisos de pedido por template (padrao: desligado, nada e enviado).
# COMANDA_BARRACA_NOMES: JSON barraca_id -> nome da barraca, usado no {{3}} do template. Ver docs/INTEGRACAO_COMANDA_EVENTOS.md.
COMANDA_NOTIFY_TEMPLATES=""
COMANDA_BARRACA_NOMES=""

# Atendente de IA no WhatsApp (fase 1). Ver docs/IA_ATENDIMENTO.md.
# IA_ATENDIMENTO: "on" liga o consumidor de entrada da IA (padrao: desligado, nada acontece).
IA_ATENDIMENTO=""
# IA_MAX_RESPOSTAS_DIA: teto GLOBAL de respostas da IA por dia (padrao 500). Passou: so manda o link do cardapio.
IA_MAX_RESPOSTAS_DIA=""
# COMANDA_IA_DONO_CONFIRMAR_URL: URL da edge function ia-dono-confirmar da Comanda (confirmacao do WhatsApp do responsavel).
COMANDA_IA_DONO_CONFIRMAR_URL=""
# Atendente de VENDAS do Saiae (mesmo numero das lojas; exige IA_ATENDIMENTO=on). Ver docs/IA_ATENDIMENTO.md.
# IA_VENDAS: "on" liga (padrao desligado). Quem chega sem #CODIGO e sem conversa de loja vai para ela.
IA_VENDAS=""
# IA_VENDAS_LINK_CADASTRO: o unico link que ela pode mandar. Exemplo: https://saiae.com.br/raio-x
IA_VENDAS_LINK_CADASTRO=""
# IA_VENDAS_WHATSAPP_RESPONSAVEL: WhatsApp da equipe do Saiae (recebe o aviso e pode mandar "LIBERAR #VENDAS").
IA_VENDAS_WHATSAPP_RESPONSAVEL=""
# IA_VENDAS_MAX_RESPOSTAS_DIA: teto diario proprio das respostas de vendas (padrao 100).
IA_VENDAS_MAX_RESPOSTAS_DIA=""
# IA_MODELO_VENDAS: modelo so da atendente de vendas (vazio: usa IA_MODELO). Lojas e vendas podem usar modelos diferentes.
IA_MODELO_VENDAS=""
# IA_TEMPLATE_CONFIRMAR: template da Meta so para o pedido de confirmacao do responsavel (ia_confirmar_responsavel). Vazio: usa o ia_chamar_dono.
IA_TEMPLATE_CONFIRMAR=""

# IA no WhatsApp: contexto da loja (Comanda, contrato SAI-002 ia-contexto). Segredo e URL so no Railway, definidos pelo dono.
# COMANDA_IA_SEGREDO: segredo de plataforma (o mesmo IA_CONTEXTO_SEGREDO da Comanda). Nunca no chat nem no repositorio.
# COMANDA_IA_URL: URL da funcao, ex.: https://<projeto>.supabase.co/functions/v1/ia-contexto
COMANDA_IA_SEGREDO=""
COMANDA_IA_URL=""

# Baileys Socket Logs Level (fatal | error | warn | info | debug | trace)
# Recommended: error for production, debug for development
BAILEYS_LOG_LEVEL="error"

# WhatsApp Cloud API oficial (Meta) - webhook em POST/GET /api/whatsapp/webhook
# Valores definidos so no painel do Railway, NUNCA no repositorio.
# WHATSAPP_VERIFY_TOKEN: texto secreto que voce escolhe (ex.: openssl rand -hex 24);
#   cole o mesmo texto no campo "Verificar token" do webhook no painel da Meta.
# WHATSAPP_APP_SECRET: "Chave secreta do app" (App Secret) do aplicativo na Meta;
#   usada para validar a assinatura X-Hub-Signature-256 de cada evento.
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""

# Envio pela Cloud API (piloto, 1 numero): credenciais SO por variavel de ambiente, nunca no banco.
# META_WA_ACCESS_TOKEN: token de acesso (usuario do sistema) do app na Meta.
# META_WA_PHONE_NUMBER_ID: phone_number_id do numero na Meta (nao e o telefone).
# WHATSAPP_GRAPH_API_VERSION: versao da Graph API (padrao v25.0). Confirme a versao usada pelo seu app da Meta.
META_WA_ACCESS_TOKEN=""
META_WA_PHONE_NUMBER_ID=""
WHATSAPP_GRAPH_API_VERSION="v25.0"
# WHATSAPP_CLOUD_SESSION_ID: ID(s) de sessao do CRM (separados por virgula) que enviam pela Cloud API.
#   Vazio = nenhuma (tudo continua no Baileys). Nao conecte o Baileys nessas sessoes. Ver docs/CLOUD_API_PILOTO.md.
WHATSAPP_CLOUD_SESSION_ID=""


# ==============================================
# 🔧 6. INTEGRATIONS & FEATURE FLAGS
# ==============================================

# Remove.bg API Key for automatic sticker background removal
# Register at https://www.remove.bg/api
REMOVE_BG_API_KEY=""

# Enable system notifications UI prompts (true | false)
ENABLE_NOTIFICATIONS="true"

# Periodically check for new Saiaê releases (true | false)
ENABLE_AUTO_UPDATE_CHECK="true"

# Enable experimental gateway features (true | false)
ENABLE_EXPERIMENTAL_FEATURES="false"


# ==============================================
# 🛡️ 7. SECURITY & LIMITS
# ==============================================

# Session token expiration duration in hours
SESSION_TIMEOUT_HOURS="24"

# Maximum media file size allowed for uploads (in Megabytes)
MAX_UPLOAD_SIZE_MB="50"

# Enable API rate limiting protection (true | false)
ENABLE_RATE_LIMITING="true"

# Maximum requests per minute allowed per IP if rate limiting is enabled
RATE_LIMIT_PER_MINUTE="60"


# ==============================================
# 🌍 8. LOCALIZATION & STORAGE
# ==============================================

# Server default timezone for scheduled campaigns (e.g., Asia/Jakarta)
TZ="Asia/Jakarta"

# Default Locale for date/time formatting on the system (e.g., id-ID, en-US)
LOCALE="id-ID"

# Media files storage folder path (relative to the project root)
MEDIA_STORAGE_PATH="uploads"

# Google Analytics tracking ID (leave empty to disable)
NEXT_PUBLIC_GA_ID=""


# ==============================================
# 🐳 9. DOCKER COMPOSE CONFIGURATION
# ==============================================
# These variables are required ONLY when deploying via docker-compose.yml
MYSQL_ROOT_PASSWORD="change-this-in-production"
MYSQL_DATABASE="wa_akg"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-this-in-production"

# ==============================================
# IA (opcional) - gerador de textos de disparo com Gemini
# ==============================================
# Chave gratuita em https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"

# ==============================================
# Stripe (assinaturas) - valores no painel do Railway
# ==============================================
STRIPE_WEBHOOK_SECRET=""
STRIPE_LINK_ESSENCIAL=""
STRIPE_LINK_PRO=""
STRIPE_LINK_ESCALA=""
STRIPE_LINK_EXTRA=""
STRIPE_PORTAL_URL=""
# E-mail transacional (redefinir senha, boas-vindas)
RESEND_API_KEY=""
EMAIL_FROM="Sai aê <nao-responda@saiae.com.br>"
