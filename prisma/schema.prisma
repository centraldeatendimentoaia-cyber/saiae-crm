// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPERADMIN
  OWNER
  STAFF
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  STICKER
  LOCATION
  CONTACT
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String
  role      Role     @default(OWNER)
  apiKey    String?  @unique // API Key for authentication

  // Assinatura (contas existentes ficam ILIMITADO)
  plan                 String    @default("ILIMITADO") // TRIAL | ESSENCIAL | PRO | ESCALA | ILIMITADO
  planStatus           String    @default("ACTIVE")    // ACTIVE | SUSPENDED
  trialEndsAt          DateTime?
  extraSessions        Int       @default(0)
  stripeCustomerId     String?
  stripeSubscriptionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  sessions  Session[]
  webhooks  Webhook[]
  notifications Notification[]
  sessionAccesses SessionAccess[]
  usageCounters UsageCounter[]
  passwordResets PasswordReset[]
  stripeSubscriptions StripeSubscription[]

  @@index([stripeCustomerId])
}

model Session {
  id          String    @id @default(cuid())
  userId      String
  name        String    // e.g. "Marketing WA"
  sessionId   String    @unique // The unique ID used for Baileys auth
  status      String    @default("DISCONNECTED") // CONNECTED, DISCONNECTED, ZOMBIE
  qr          String?   @db.Text
  config      Json?     // Store instance specific config (e.g. "read_receipts": true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  contacts    Contact[]
  messages    Message[]
  groups      Group[]
  autoReplies AutoReply[]
  stories     Story[]
  scheduledMessages ScheduledMessage[]
  webhooks    Webhook[]
  botConfig   BotConfig?
  sessionAccesses SessionAccess[]
}

model Contact {
  id          String   @id @default(cuid())
  sessionId   String
  jid         String   // remoteJid (123456@s.whatsapp.net)
  lid         String?  // LID JID
  name        String?
  notify      String?  // Pushname
  verifiedName String? // Business Name
  remoteJidAlt String? // Alternate JID (e.g. Phone if JID is LID)
  lastInboundAt DateTime? // última vez que essa pessoa mandou mensagem para o número (filtro "só quem já interagiu")
  profilePic  String?  @db.Text
  data        Json?    // Detailed contact data
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  messages    Message[]

  @@unique([sessionId, jid])
}

model Message {
  id          String        @id @default(cuid())
  sessionId   String
  remoteJid   String        // Receiver or Group Jid
  senderJid   String?       // If group, who sent it. If private, same as remoteJid (incoming) or me (outgoing)
  fromMe      Boolean
  keyId       String        // WhatsApp Message Key ID
  pushName    String?
  type        MessageType   @default(TEXT)
  content     String?       @db.Text // Text content or Caption
  mediaUrl    String?       @db.Text // Path to file if media
  status      MessageStatus @default(PENDING)
  timestamp   DateTime      @default(now())
  
  quoteId     String?       // For replies
  
  contactId   String?
  contract    Contact?      @relation(fields: [contactId], references: [id])
  session     Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, keyId])
  @@index([sessionId, remoteJid])
  @@index([sessionId, remoteJid, timestamp])
}

model Group {
  id          String   @id @default(cuid())
  sessionId   String
  jid         String
  subject     String?
  description String?  @db.Text
  ownerJid    String?
  participants Json?   // Stored as JSON for now: [{id: '123@s.whatsapp.net', admin: 'admin' | null}]
  creation    DateTime?
  restrict    Boolean? // Only admins can edit group info
  announce    Boolean? // Only admins can send messages
  
  metadata    Json?    // Raw full metadata dump
  
  inviteCode  String?
  
  // Community Features
  isCommunity Boolean  @default(false)
  linkedParentJid String? // JID of the community parent group if it belongs to one
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, jid])
}

model AutoReply {
  id          String   @id @default(cuid())
  sessionId   String
  keyword     String
  matchType   String   // EXACT, CONTAINS, REGEX
  response    String?  @db.Text
  isMedia     Boolean  @default(false)
  mediaUrl    String?
  mediaType   String?
  triggerType String   @default("ALL") // ALL, GROUP, PRIVATE
  createdAt   DateTime @default(now())

  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model Story {
  id          String   @id @default(cuid())
  sessionId   String
  jid         String   // User who posted the story or Broadcast JID
  content     String?  @db.Text
  mediaUrl    String?  @db.Text
  type        String   // IMAGE, VIDEO, TEXT
  timestamp   DateTime @default(now())
  viewed      Boolean  @default(false)

  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model ScheduledMessage {
  id          String   @id @default(cuid())
  sessionId   String
  jid         String
  content     String?  @db.Text
  mediaUrl    String?
  mediaType   String?  // image, video, document, etc.
  sendAt      DateTime
  cronExpression String? // e.g., '*/5 * * * *'
  recurrenceRule String? @db.Text // UI JSON state
  status      String   @default("PENDING") // PENDING, SENT, FAILED
  createdAt   DateTime @default(now())

  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

// Store for Baileys MultiFileAuthState (in DB)
model AuthState {
  id        String   @id @default(cuid())
  sessionId String
  key       String   // Filename/Key (creds.json, etc)
  value     Json
  
  @@unique([sessionId, key])
}

// Webhook configuration for external event notifications
model Webhook {
  id          String   @id @default(cuid())
  userId      String
  sessionId   String?  // Optional: specific session, null = all sessions
  name        String   // e.g. "My Server Webhook"
  url         String   // The webhook endpoint URL
  secret      String?  // Optional secret for HMAC signing
  events      Json     // Array of event types: ["message.received", "message.sent", "connection.update", etc.]
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  session     Session? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  logs        WebhookLog[]
}

// Webhook delivery logs — tracks every webhook request attempt
model WebhookLog {
  id                 String   @id @default(cuid())
  webhookId          String
  event              String   // The event that triggered this webhook
  status             String   // SUCCESS, FAILED
  requestUrl         String   @db.Text
  requestHeaders     Json?
  requestBody        Json?
  responseStatusCode Int?
  responseBody       String?  @db.Text
  responseTimeMs     Int?
  errorMessage       String?  @db.Text
  createdAt          DateTime @default(now())

  webhook            Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId])
  @@index([webhookId, createdAt])
}

enum AccessMode {
  ALL
  OWNER
  SPECIFIC
  BLACKLIST
}

model BotConfig {
  id            String   @id @default(cuid())
  sessionId     String   @unique
  enabled       Boolean  @default(true)
  
  // Bot Command Access
  botName       String   @default("Saiaê Bot")
  botMode       AccessMode @default(OWNER)
  botAllowedJids Json?     // Array of JIDs ["628123@s.whatsapp.net"]
  botBlockedJids Json?     // Array of JIDs ["628123@s.whatsapp.net"] for BLACKLIST mode

  // Auto Reply Access
  autoReplyMode AccessMode @default(ALL)
  autoReplyAllowedJids Json?
  autoReplyBlockedJids Json? // Array of JIDs for BLACKLIST mode

  enableSticker Boolean  @default(true)
  enableVideoSticker Boolean @default(true)
  maxStickerDuration Int @default(10) // in seconds
  enablePing    Boolean  @default(true)
  enableUptime  Boolean  @default(true)
  removeBgApiKey String?
  prefix        String   @default("#")
  
  // Anti-Spam / Rate Limit
  antiSpamEnabled Boolean @default(true) // liga também o Modo Seguro dos disparos (src/lib/safe-mode.ts)
  spamLimit       Int     @default(5)    // Messages allowed in window
  spamInterval    Int     @default(10)   // Seconds window
  spamDelayMin    Int     @default(1000) // MS min delay
  spamDelayMax    Int     @default(3000) // MS max delay

  // Modo Seguro dos disparos (valem quando antiSpamEnabled = true)
  safeDelayMin    Int     @default(10)   // segundos entre mensagens (mín.)
  safeDelayMax    Int     @default(40)   // segundos entre mensagens (máx.)
  safeBatchSize   Int     @default(25)   // pausa a cada N envios (0 = sem pausa)
  safeBatchPause  Int     @default(3)    // minutos de pausa entre lotes
  safeStartHour   Int     @default(9)    // janela de envio (seg a sáb)
  safeEndHour     Int     @default(19)

  // Disparos e agendamentos só para quem já mandou mensagem para este número
  onlyInteracted  Boolean @default(false)

  // Automation & Presence
  welcomeMessage  String? @db.Text
  autoRead        Boolean @default(false)
  alwaysOnline    Boolean @default(false)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  session       Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model SystemConfig {
  id                 String   @id @default("default") // Singleton ID
  appName            String   @default("Saiaê")
  logoUrl            String?
  faviconUrl         String?
  timezone           String   @default("Asia/Jakarta")
  enableRegistration Boolean  @default(true)
  
  updatedAt          DateTime @updatedAt
}

// Labels/Tags for organizing chats
model Label {
  id          String      @id @default(cuid())
  sessionId   String
  name        String
  color       Int         @default(0) // 0-19 for WhatsApp color codes
  colorHex    String      @default("#FF0000") // Hex representation
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  
  chatLabels  ChatLabel[]
  
  @@unique([sessionId, name]) // Unique label name per session
  @@index([sessionId])
}

// Many-to-many relationship between chats and labels
model ChatLabel {
  id        String   @id @default(cuid())
  labelId   String
  chatJid   String   // The JID of the chat
  createdAt DateTime @default(now())
  
  label     Label    @relation(fields: [labelId], references: [id], onDelete: Cascade)
  
  @@unique([labelId, chatJid]) // Prevent duplicate label assignments
  @@index([chatJid])
  @@index([labelId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String   @db.Text
  type      String   @default("INFO") // INFO, WARNING, SUCCESS, SYSTEM
  read      Boolean  @default(false)
  href      String?
  
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Shared session access — allows session owners to grant access to other users
model SessionAccess {
  id        String   @id @default(cuid())
  sessionId String
  userId    String
  createdAt DateTime @default(now())

  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@index([userId])
  @@index([sessionId])
}

// Broadcast/Blast history & logs
model BroadcastLog {
  id          String              @id @default(cuid())
  sessionId   String              // WA session ID string
  message     String              @db.Text
  total       Int
  sent        Int                 @default(0)
  failed      Int                 @default(0)
  status      String              @default("running") // running, completed, cancelled
  delay       Int                 @default(2000)
  startedAt   DateTime            @default(now())
  completedAt DateTime?

  recipients  BroadcastRecipient[]

  @@index([sessionId])
  @@index([sessionId, startedAt])
}

model BroadcastRecipient {
  id              String       @id @default(cuid())
  broadcastLogId  String
  jid             String
  status          String       @default("pending") // pending, sent, failed
  error           String?      @db.Text
  sentAt          DateTime?

  broadcastLog    BroadcastLog @relation(fields: [broadcastLogId], references: [id], onDelete: Cascade)

  @@index([broadcastLogId])
}

// Controle de conversas lidas no painel (para o contador de não lidas)
model ChatRead {
  id         String   @id @default(cuid())
  sessionId  String   // Session.id (cuid)
  jid        String
  lastReadAt DateTime @default(now())

  @@unique([sessionId, jid])
  @@index([sessionId])
}

// Consumo mensal por conta (disparos e textos de IA)
model UsageCounter {
  id            String   @id @default(cuid())
  userId        String
  period        String   // AAAA-MM
  messages      Int      @default(0)
  aiGenerations Int      @default(0)

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, period])
  @@index([userId])
}

// Mensagens enviadas por número em cada dia (limite diário do Modo Seguro)
model SendDaily {
  sessionId String   // WA session ID string
  day       String   // AAAA-MM-DD (America/Sao_Paulo)
  count     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@id([sessionId, day])
}

// Links de redefinição de senha (guarda só o hash do token)
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Assinaturas da Stripe vinculadas a uma conta (uma conta pode ter plano + números extras)
model StripeSubscription {
  id            String   @id // sub_...
  userId        String
  customerId    String
  status        String   @default("incomplete") // active, trialing, past_due, canceled, unpaid...
  planKey       String?  // ESSENCIAL | PRO | ESCALA
  extraQuantity Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([customerId])
}

// Registro dos webhooks recebidos (idempotência e eventos que chegam fora de ordem)
model StripeEvent {
  id          String    @id // evt_...
  type        String
  objectId    String?
  payload     Json
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([objectId])
}

// Imagens enviadas pelo cliente para disparos e agendamentos (ficam no banco: o disco do servidor é efêmero)
model MediaFile {
  id        String   @id @default(cuid())
  userId    String
  name      String
  mime      String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())

  @@index([userId])
}

// Quem respondeu SAIR: não recebe mais disparos desse número (phoneKey = últimos 8 dígitos, ignora o 9º dígito)
model OptOut {
  id        String   @id @default(cuid())
  sessionId String   // WA session ID string
  phoneKey  String
  jid       String
  createdAt DateTime @default(now())

  @@unique([sessionId, phoneKey])
}

// ---------------------------------------------------------------------------------------------
// Atendente de IA no WhatsApp (fase 1). SO TABELAS NOVAS: nada existente muda.
// ATENCAO: o CRM roda `prisma db push` em todo start; mergear esta mudanca e publicar CRIA ESTAS TABELAS
// no banco de producao. Ver docs/CRM_SCHEMA_APLICA_NO_MERGE.md.
// ---------------------------------------------------------------------------------------------

/// Uma conversa por (loja, cliente). `contactKey` = telefone com DDI, ou BSUID se o telefone estiver oculto.
model IaConversa {
  id              String       @id @default(cuid())
  lojaCodigo      String // codigo de 6 caracteres do link da loja (ia_codigo da Comanda)
  contactKey      String
  estado          String       @default("ia") // ia | humano
  pausadaAte      DateTime? // humano: volta sozinha a ia depois disso
  ultimaMensagemEm DateTime    @default(now())
  criadoEm        DateTime     @default(now())

  mensagens       IaMensagem[]

  @@unique([lojaCodigo, contactKey])
  @@index([contactKey, ultimaMensagemEm])
}

/// Mensagens da conversa. Retencao maxima de 30 dias (limpeza diaria). `providerMessageId` (wamid) garante
/// idempotencia: a Meta reenvia o mesmo webhook.
model IaMensagem {
  id                String     @id @default(cuid())
  conversaId        String
  providerMessageId String     @unique
  direcao           String // in | out
  texto             String     @db.Text
  criadoEm          DateTime   @default(now())

  conversa          IaConversa @relation(fields: [conversaId], references: [id], onDelete: Cascade)

  @@index([conversaId, criadoEm])
  @@index([criadoEm])
}

/// Conversas contadas por loja e mes (limite do plano). `mes` = AAAA-MM.
model IaConsumo {
  id         String @id @default(cuid())
  lojaCodigo String
  mes        String
  conversas  Int    @default(0)

  @@unique([lojaCodigo, mes])
}

/// Interessados que chegam pela atendente de vendas do Saiae (mesmo numero das lojas). Guarda so o necessario para a
/// equipe retomar o contato: telefone (contactKey), nome, tipo de negocio, cidade e origem (panfleto | outro).
/// Nunca guarda o texto das conversas. Apagada junto com os dados do telefone (rota ia-apagar-conversas).
model IaLead {
  id           String   @id @default(cuid())
  contactKey   String   @unique
  nome         String?
  negocio      String?
  cidade       String?
  origem       String   @default("outro") // panfleto | outro
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

// ---------------------------------------------------------------------------------------------
// Agente de atendimento por sessão (QR/Baileys): a "Lavínia" do salão. Tabelas novas, só acréscimo.
// ---------------------------------------------------------------------------------------------

/// Configuração do agente de um número (sessão). `conhecimento` é o texto que o dono edita; vazio = texto padrão da Lavínia.
model AgenteConfig {
  sessionId        String   @id // ID da sessão (string do Baileys)
  ativo            Boolean  @default(false)
  nome             String   @default("Lavínia")
  conhecimento     String?  @db.MediumText
  promocoes        String?  @db.Text
  linkAgendamento  String?
  grupoRecepcaoJid String? // grupo de WhatsApp da recepção (recebe "Cliente aguardando resposta - bot")
  numerosIgnorados Json? // telefones (só dígitos) que a IA nunca atende: equipe, dono
  followUpHoras    Int      @default(12)
  pausaHoras       Int      @default(12) // quanto a IA fica calada depois que uma pessoa assume ou a recepção é chamada
  diasAbertos      String   @default("2,3,4,5,6") // 0=domingo ... 6=sábado (terça a sábado)
  horaAbre         Int      @default(9)
  horaFecha        Int      @default(18)
  atualizadoEm     DateTime @updatedAt
}

/// Estado de cada conversa atendida pelo agente (uma por contato e sessão).
model AgenteConversa {
  id                String    @id @default(cuid())
  sessionId         String
  jid               String // chat como o WhatsApp entrega (telefone ou @lid)
  telefone          String? // só dígitos, quando conhecido
  nomePerfil        String?
  servico           String?
  estado            String    @default("ia") // ia | humano
  pausadaAte        DateTime?
  motivoPausa       String?
  ultimaInboundAt   DateTime?
  ultimaIaAt        DateTime?
  ultimaIaPerguntou Boolean   @default(false)
  ultimaHumanoAt    DateTime?
  followUpEm        DateTime?
  criadoEm          DateTime  @default(now())
  atualizadoEm      DateTime  @updatedAt

  @@unique([sessionId, jid])
  @@index([sessionId, estado])
  @@index([sessionId, ultimaIaAt])
}
